class Solution:
    def hasValidPath(self, grid):
        m = len(grid)
        n = len(grid[0])

        # Total number of cells must be even
        if (m + n - 1) % 2 != 0:
            return False

        # dp[i][j] stores possible balance values
        dp = [[set() for _ in range(n)] for _ in range(m)]

        # Starting cell must be '('
        if grid[0][0] == '(':
            dp[0][0].add(1)
        else:
            return False

        for i in range(m):
            for j in range(n):

                if i == 0 and j == 0:
                    continue

                if grid[i][j] == '(':
                    change = 1
                else:
                    change = -1

                # Come from the top
                if i > 0:
                    for balance in dp[i - 1][j]:
                        new_balance = balance + change

                        if new_balance >= 0:
                            dp[i][j].add(new_balance)

                # Come from the left
                if j > 0:
                    for balance in dp[i][j - 1]:
                        new_balance = balance + change

                        if new_balance >= 0:
                            dp[i][j].add(new_balance)

        # We need balance = 0 at the final cell
        return 0 in dp[m - 1][n - 1]
